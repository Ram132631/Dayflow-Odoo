# PostgreSQL connection string
# Local example: postgresql://postgres:postgres@localhost:5432/dayflow?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dayflow?schema=public"

# Auth.js
# Generate a secret with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Base URL used to build dev-mode email verification links
APP_URL="http://localhost:3000"
