# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Patterns are unanchored (no leading slash) so they match inside both
# frontend/ and backend/, not just the repo root.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build
dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploads (local dev file storage)
public/uploads/*
!public/uploads/.gitkeep
