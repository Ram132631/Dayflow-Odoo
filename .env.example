# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dayflow?schema=public"

# Server
PORT=4000
NODE_ENV=development

# Used to build dev-mode email verification links returned in API responses
APP_URL="http://localhost:3000"

# Origin allowed to make credentialed requests (the Next.js frontend)
FRONTEND_ORIGIN="http://localhost:3000"

# JWT signing secret — generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
